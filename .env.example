# ============================================================================
#  HQRTM — exempel på miljövariabler.
#  Kopiera till .env (ligger i .gitignore) och fyll i. CHECKA ALDRIG IN .env!
#  Publikt repo: ingen riktig hemlighet får finnas här.
# ============================================================================

# ---- MongoDB (Atlas free-tier — replica set direkt, krävs för Change Streams) ----
# Atlas-format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=hqrtm

# ---- Flask / web ----
FLASK_ENV=development
# Generera: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only
JWT_SECRET=change-me-dev-only
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ---- Telegram (BotFather) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- Poller / källa ----
POLL_INTERVAL_MS=3000
# Fönster för adaptiv frekvens (timmar, lokal tid): "08-22" — tätare dagtid
HOT_HOURS=08-22

# ---- HomeQ Core API (docs-core.homeq.se) ----
# Åtkomst/integrationskonto — från landlord-portalen: homeq.se/biz → settings/integration.
# Adaptern aktiveras (enabled=True) först efter bekräftad ToS (COMPLIANCE.md).
HOMEQ_BASE_URL=https://api.homeq.se
# demo-miljö: https://api-demo.homeq.se
HOMEQ_PUBLIC_BASE=https://homeq.se
HOMEQ_USERNAME=
HOMEQ_PASSWORD=
HOMEQ_FETCH_AMOUNT=100

# ---- Qasa (qasa.com, GraphQL) ----
# Publik anonym marketplace-sökning (homeIndexSearch), schema verifierat → enabled=True.
QASA_API_URL=https://api.qasa.com/graphql
QASA_PUBLIC_BASE=https://qasa.com
QASA_FETCH_AMOUNT=50
# Begränsa till orter (kommaseparerat, areaIdentifier). Tomt = hela landet.
# Ex: QASA_AREAS=se/goteborg,se/stockholm,se/malmo
QASA_AREAS=

# ---- Bostadsförmedlingen i Stockholm (kommunalt öppet data, enabled=True) ----
BOSTADSFORMEDLINGEN_API_URL=https://bostad.stockholm.se/AllaAnnonser/?vy=lista
BOSTADSFORMEDLINGEN_PUBLIC_BASE=https://bostad.stockholm.se

# ---- HomeQ publik bevakning (beta, web-only) ----
# Pollern hämtar HomeQ:s inloggningsfria Card Search (utan JWT) och filtrerar på bbox.
# ⚠️ Ägarens beslut/risk gällande ToS. Sätt true för att aktivera i poller-cron.
HOMEQ_PUBLIC_POLL=false
# "min_lat,max_lat,min_lng,max_lng" — Göteborg storstadsområde (tom = hela landet)
HOMEQ_BBOX=57.30501310262437,57.951573625160904,11.299629385756305,12.662900614241892
HOMEQ_PUBLIC_LIMIT=50

# ---- Samtrygg (samtrygg.se) ----
# ⚠️ Host saknas i den publika SwaggerHub-specen, ToS ej bekräftad → enabled=False.
# Fastställ bas-URL för endpointen GetHomePageObjects före aktivering (ägarens beslut).
SAMTRYGG_API_URL=
SAMTRYGG_PUBLIC_BASE=https://samtrygg.se

# ---- Observerbarhet / robusthet (Fas 8) ----
LOG_LEVEL=INFO
# JSON-loggar för aggregatorer i prod (true/false)
LOG_JSON=false
# Backend för rate-limit-räknare. Tom → in-memory (en process/dev).
# Multiprocess/prod: t.ex. redis://localhost:6379
RATELIMIT_STORAGE_URI=
