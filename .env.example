# ============================================================================
#  HQRTM — пример переменных окружения.
#  Скопируйте в .env (он в .gitignore) и заполните. НИКОГДА не коммитьте .env!
#  Публичный репозиторий: ни одного реального секрета здесь быть не должно.
# ============================================================================

# ---- MongoDB (Atlas free-tier — replica set из коробки, нужен для Change Streams) ----
# Формат Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=hqrtm

# ---- Flask / web ----
FLASK_ENV=development
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only
JWT_SECRET=change-me-dev-only
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ---- Telegram (BotFather) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- Poller / источник ----
POLL_INTERVAL_MS=3000
# Окна адаптивной частоты (часы, локальное время): "08-22" — учащение днём
HOT_HOURS=08-22

# ---- HomeQ Core API (docs-core.homeq.se) ----
# Доступ/учётка интеграции — из landlord-портала: homeq.se/biz → settings/integration.
# Адаптер включается (enabled=True) только после подтверждения ToS (COMPLIANCE.md).
HOMEQ_BASE_URL=https://api.homeq.se
# demo-окружение: https://api-demo.homeq.se
HOMEQ_PUBLIC_BASE=https://homeq.se
HOMEQ_USERNAME=
HOMEQ_PASSWORD=
HOMEQ_FETCH_AMOUNT=100

# ---- Qasa (qasa.com, GraphQL) ----
# ⚠️ Контракт API не верифицирован, ToS на программный доступ не подтверждён → enabled=False.
QASA_API_URL=https://api.qasa.com/graphql
QASA_PUBLIC_BASE=https://qasa.com
QASA_FETCH_AMOUNT=50

# ---- Samtrygg (samtrygg.se) ----
# ⚠️ Host в публичной SwaggerHub-спеке не задан, ToS не подтверждён → enabled=False.
# Перед включением уточнить базовый URL эндпоинта GetHomePageObjects (действие владельца).
SAMTRYGG_API_URL=
SAMTRYGG_PUBLIC_BASE=https://samtrygg.se

# ---- Логирование ----
LOG_LEVEL=INFO
