{
  "manifest_version": 3,
  "name": "HQRTM Snabbansök",
  "version": "0.1.0",
  "description": "Snabb åtkomst till matchande bostäder + autofyll av din ansökningsprofil — lokalt, i din egen webbläsare. Inga lösenord lagras på server.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://hqrtm.onrender.com/*",
    "https://homeq.se/*",
    "https://qasa.com/*",
    "https://bostad.stockholm.se/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HQRTM Snabbansök"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://homeq.se/*",
        "https://qasa.com/*",
        "https://bostad.stockholm.se/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
